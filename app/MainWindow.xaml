<Window x:Class="Mastermind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Mastermind"
        Title="Mastermind"
        Width="396" Height="560" MinWidth="396"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource Sans}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1"
                        CornerRadius="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
  <!-- Root surface: semi-opaque so the Win11 acrylic backdrop tints through.
       CornerRadius matches the OS window rounding (~8px) so the dark fill aligns
       with the DWM-rounded window edge — a larger radius leaves an acrylic crescent. -->
  <Border x:Name="Root" CornerRadius="8" Background="#D91A1B22"
          BorderThickness="1" BorderBrush="#26FFFFFF" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- TOAST OVERLAY: transient Warn banners off the LogStore funnel (see ShowToast). Auto-dismiss,
           click-through (IsHitTestVisible=False so it never blocks the cards), floated bottom-LEFT on top of
           everything via ZIndex — over the first card column, where the eye already is; on a wide fullscreen
           monitor the right edge is outside it. Neutral, ⚠ and bright text — every hue on the panel names a card
           status, so a failure the log strip would let scroll past stands out by brightness and place. -->
      <ItemsControl x:Name="ToastHost" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="100"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,16"
                    IsHitTestVisible="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#F2202128" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="9"
                    Padding="13,9" Margin="0,7,0,0" MaxWidth="330">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="#000000"/>
              </Border.Effect>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x26A0;" Foreground="{StaticResource TextHi}" FontSize="12.5" FontWeight="Bold"
                           Margin="0,0,9,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding}" Foreground="{StaticResource TextHi}" FontSize="11.5" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- soft neutral glow behind the header. RowSpan 0-1 + Top align so its fixed 92px draws over the top of
           the list WITHOUT forcing the Auto header row to 92px (that was the giant gap above the cards). -->
      <Border Grid.Row="0" Grid.RowSpan="2" Height="92" VerticalAlignment="Top" CornerRadius="8,8,0,0" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#14FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- ============================ HEADER ============================ -->
      <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent" Padding="16,3,10,2"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- glowing live dot -->
          <Grid Grid.Column="0" VerticalAlignment="Center" Margin="2,0,11,0">
            <Ellipse x:Name="LiveDot" Width="10" Height="10" Fill="{StaticResource Accent}">
              <Ellipse.Effect>
                <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/>
              </Ellipse.Effect>
            </Ellipse>
          </Grid>

          <!-- Title + the who-needs-you badge on the LEFT, beside each other: the count is read, not clicked, so it
               sits where the eye starts (the header buttons on the right are clicked, not watched). -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Mastermind" FontFamily="{StaticResource Display}" VerticalAlignment="Center"
                       FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextHi}"/>
            <Border x:Name="CountBadge" CornerRadius="9" Background="#226EA8FE"
                    Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                    ToolTip="Agents waiting on you — a permission, an idle wait, or a finished turn">
              <TextBlock x:Name="CountText" Text="0" Foreground="{StaticResource Blue}"
                         FontSize="11.5" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource ChromeButton}" Content="&#xE72C;" ToolTip="Refresh session list"
                    Click="Refresh_Click"/>
            <Button x:Name="FullscreenButton" Style="{StaticResource ChromeButton}" Content="&#xE740;"
                    ToolTip="Fullscreen" Click="Fullscreen_Click"/>
            <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="Hide to tray"
                    Click="Minimize_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============================ LIST ============================== -->
      <!-- 12px top padding: breathing room between the title bar and the first card row (the cards used to
           start flush under the header; the phantom-row removals bought back the height it costs). -->
      <ScrollViewer x:Name="ListScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Padding="14,12,10,2" CanContentScroll="False"
                    PreviewMouseWheel="ListScroller_PreviewMouseWheel" SizeChanged="ListScroller_SizeChanged">
        <Grid>
          <!-- empty state: genuine quiet (nothing needs you) -->
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Margin="0,40,0,60">
            <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="34" Foreground="#3AFFFFFF" HorizontalAlignment="Center"/>
            <TextBlock Text="All quiet" Foreground="{StaticResource TextMid}" FontSize="14"
                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,2"/>
            <TextBlock Text="Agents will show up here when they&#x0a;need you or finish a task."
                       Foreground="{StaticResource TextLo}" FontSize="11.5" TextAlignment="Center"
                       HorizontalAlignment="Center"/>
          </StackPanel>

          <!-- degraded state: VS Code is open but its workspaces are unreadable (IDE locks missing) — the
               empty list is a blind spot, NOT genuine quiet. Bright with the warning glyph, against the quiet
               state's dim one, so it never reads as "all clear"; no hue — those name card statuses. -->
          <StackPanel x:Name="DegradedState" Visibility="Collapsed" VerticalAlignment="Center"
                      HorizontalAlignment="Center" Margin="20,40,20,60">
            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="34" Foreground="{StaticResource TextHi}" HorizontalAlignment="Center"/>
            <TextBlock Text="Can't see your sessions" Foreground="{StaticResource TextHi}" FontSize="14"
                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,2"/>
            <TextBlock Text="VS Code is running but its workspaces aren't&#x0a;readable yet. This isn't &quot;all quiet&quot; — try Refresh."
                       Foreground="{StaticResource TextLo}" FontSize="11.5" TextAlignment="Center"
                       HorizontalAlignment="Center"/>
          </StackPanel>

          <ItemsControl x:Name="EventList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Resources>
              <!-- Incoming-prompts inbox: a FIRST-position card in the same wrap flow, SAME EventCard shell as
                   the session cards (same width / corner / border / plain surface) — its file list is what sets it
                   apart; a tint would borrow a status hue. DataContext is the PromptStore singleton; the inner list is
                   its Items. HIDDEN while there are no prompts: an empty inbox would spend a whole card slot — one of
                   only two per column on a short screen — to say nothing (auto-move has nothing to act on then either). -->
              <DataTemplate DataType="{x:Type local:PromptStore}">
                <Border>
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource EventCard}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <!-- Height is the shared EventCard height (App.xaml CardHeight, every card the same); the prompt list
                       scrolls INSIDE the * row so the card never grows or shrinks with prompt count. -->
                  <Grid Margin="13,11,13,12">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                      <TextBlock Text="INCOMING PROMPTS" FontSize="10.5" FontWeight="Bold"
                                 Foreground="{StaticResource TextHi}" VerticalAlignment="Center"/>
                      <CheckBox Content="auto-move" HorizontalAlignment="Right" FontSize="11"
                                Foreground="{StaticResource TextLo}" VerticalAlignment="Center"
                                IsChecked="{Binding AutoMove, Mode=TwoWay}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <!-- Row layout is STACKED, not side-by-side: the FILENAME owns a full-width line of its
                                 own, and the state pill + route + action buttons share the line below it. The
                                 filename IS the contract (the dispatched command names it verbatim), so it's the
                                 one field that must stay readable — sharing its line with the buttons left it
                                 ellipsised at roughly half the card width, which hid exactly the tail that tells
                                 two handoffs apart. It shows without its {SRC}to{DST}__ prefix, which the route
                                 label below already carries; the full name on hover as the backstop. -->
                            <Grid Margin="0,3,0,5" Opacity="{Binding RowOpacity}">
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- 0 filename, full width -->
                                <RowDefinition Height="Auto"/>   <!-- 1 state + route | actions -->
                                <RowDefinition Height="Auto"/>   <!-- 2 park hint -->
                              </Grid.RowDefinitions>
                              <TextBlock Grid.Row="0" Text="{Binding DisplayName}" Foreground="{StaticResource TextHi}"
                                         FontSize="11.5" TextTrimming="CharacterEllipsis"
                                         ToolTip="{Binding FileName}"/>
                              <Grid Grid.Row="1" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                  <Border Style="{StaticResource Pill}" Background="{Binding Accent}" Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource PillText}" Text="{Binding StateText}" Foreground="#101015"/>
                                  </Border>
                                  <!-- Trimmed: BOTH halves of RouteText come from unbounded [A-Z]+ captures in
                                       PromptRoute's filename regex (and an UNRESOLVED dst still renders its raw
                                       token here), so this is not limited to short routing codes. A WPF
                                       Grid doesn't clip, so without this an oversized route would render straight
                                       over the action buttons in the Auto column beside it. -->
                                  <TextBlock Text="{Binding RouteText}" Foreground="{StaticResource TextMid}" FontSize="11"
                                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                             ToolTip="{Binding RouteText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                  <Button Content="move &#x25B8;" IsEnabled="{Binding MoveEnabled}"
                                          Click="PromptMove_Click" FontSize="10" Padding="6,2" Margin="0,0,4,0">
                                    <Button.Style>
                                      <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Visibility" Value="{Binding MoveVisibility}"/>
                                        <Style.Triggers>
                                          <!-- auto-move on ⇒ the file auto-transports; hide the manual move so the two can't conflict -->
                                          <DataTrigger Binding="{Binding DataContext.AutoMove, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Button.Style>
                                  </Button>
                                  <Button Style="{StaticResource GhostButton}" Content="new" Visibility="{Binding DispatchVisibility}"
                                          IsEnabled="{Binding DispatchEnabled}" Click="PromptNew_Click" FontSize="10" Padding="6,2" Margin="0,0,4,0"/>
                                  <Button Style="{StaticResource GhostButton}" Content="send &#x25BE;" Visibility="{Binding DispatchVisibility}"
                                          IsEnabled="{Binding DispatchEnabled}" Click="PromptSendMenu_Click" FontSize="10" Padding="6,2" Margin="0,0,4,0"/>
                                  <Button Style="{StaticResource GhostButton}" Content="back to inbox" Visibility="{Binding BackVisibility}"
                                          Click="PromptBack_Click" FontSize="10" Padding="6,2" Margin="0,0,4,0"/>
                                  <Button Style="{StaticResource GhostButton}" Content="delete" Visibility="{Binding DeleteVisibility}"
                                          Click="PromptDelete_Click" FontSize="10" Padding="6,2" Foreground="{StaticResource TextLo}"/>
                                </StackPanel>
                              </Grid>
                              <TextBlock Grid.Row="2" Text="{Binding ParkHint}" Visibility="{Binding ParkHintVisibility}"
                                         Foreground="{StaticResource TextLo}" FontSize="11" Margin="0,3,0,0"
                                         TextTrimming="CharacterEllipsis"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                </Border>
              </DataTemplate>
              <!-- Session card -->
              <DataTemplate DataType="{x:Type local:AgentEvent}">
                <!-- The card shell is deliberately UNIFORM: flat Surface, neutral hairline border. Project
                     identity lives on ONE element (the monogram chip in the secondary row) and the heavy-model
                     state on ONE element (the filled model toggle) — the earlier per-project wash + coloured
                     border + fable red border stacked three meanings onto the card surfaces and none of them
                     read. Borders carry no meaning; don't re-hang one here. -->
                <Border Style="{StaticResource EventCard}" ToolTip="{Binding Cwd}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- (The left status accent bar is GONE — the status pill is the one status surface now,
                         sized like the monogram chip so the two identity/state anchors read as peers.) -->
                    <!-- Placeholder rows TOP-ALIGN like every other card (the old center-the-sparse-content
                         trigger is gone): the monogram chip row is the grid's anchor line, and a chip floating
                         mid-card while every neighbour's sits at the top read as broken, not intentional. -->
                    <!-- BOTTOM-ANCHORED GRID (not a StackPanel): the header rows are Auto at the top, the
                         BOTTOM rows (token bar / auto-allow+send / actions) are Auto pinned at the bottom,
                         and the DETAIL text takes the * row between — it absorbs whatever the optional rows
                         (duplicate / todo / permission) don't use. Two invariants this buys, both load-bearing:
                         (1) the bottom controls sit at a CONSTANT offset from the card's bottom edge on every
                         card (muscle-memory clicks), and (2) a todo list / permission row appearing mid-turn
                         eats from the TEXT, never shoves the buttons (no ripple). A fixed detail Height can't
                         give either — the button position would drift by whichever optional rows are present. -->
                    <Grid Grid.Column="1" Margin="13,8,6,9">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 0 title -->
                        <RowDefinition Height="Auto"/>   <!-- 1 identity: chip + name | status -->
                        <RowDefinition Height="Auto"/>   <!-- 2 duplicate pill -->
                        <RowDefinition Height="*"/>      <!-- 3 detail text — fills the slack -->
                        <RowDefinition Height="Auto"/>   <!-- 4 todo -->
                        <RowDefinition Height="Auto"/>   <!-- 5 token bar + time -->
                        <RowDefinition Height="Auto"/>   <!-- 6 allow/deny -->
                        <RowDefinition Height="Auto"/>   <!-- 7 auto-allow + send -->
                        <RowDefinition Height="Auto"/>   <!-- 8 actions + stalled -->
                      </Grid.RowDefinitions>
                      <!-- PRIMARY: the session title — ALSO the navigate target (click → focus the VS Code
                           window + CDP-switch the sidebar to this session). ALWAYS visible: a card with no
                           resolved title shows a muted default instead of a blank slot ("open in VS Code" on
                           placeholders, "new session" on live pre-resolve cards — TitleDisplay/TitleBrush),
                           so the title row is a constant anchor and needs no reserve rule. -->
                      <TextBlock Grid.Row="0" Text="{Binding TitleDisplay}"
                                 FontFamily="{StaticResource Display}"
                                 FontSize="15" FontWeight="SemiBold" Foreground="{Binding TitleBrush}"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                 LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                 Cursor="Hand" MouseLeftButtonUp="Navigate_Click" ToolTip="{Binding TitleDisplay}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="TextDecorations" Value="Underline"/>
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>

                      <!-- SECONDARY: monogram chip + project name on the LEFT, status pill on the RIGHT of the
                           same row. (ALL card section rows share the same 5px top margin — one rhythm; change
                           them together or the card reads ragged.) -->
                      <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                          <!-- The MONOGRAM CHIP is the project-identity element — INVERTED, a bright neutral fill
                               with dark initials: identity rides brightness and the TEXT, status rides hue, so the
                               two never compete for one channel (a hued chip beside a same-hued status pill read as
                               one signal). A step below the title's white so the title stays the brightest thing on
                               the card. Big on purpose: it announces the project, the muted name beside it just
                               spells it out. -->
                          <Border CornerRadius="6" Background="{StaticResource Accent}" Padding="9,3"
                                  Visibility="{Binding ProjectVisibility}" VerticalAlignment="Center"
                                  Cursor="Hand" MouseLeftButtonUp="Navigate_Click" ToolTip="Go to this session">
                            <TextBlock Text="{Binding ProjectMonogram}" FontSize="12.5" FontWeight="Bold"
                                       Foreground="#101015"/>
                          </Border>
                          <TextBlock Text="{Binding ProjectName}" Visibility="{Binding ProjectVisibility}"
                                     Foreground="{StaticResource TextMid}" FontSize="11.5"
                                     Margin="8,0,0,0" VerticalAlignment="Center"
                                     Cursor="Hand" MouseLeftButtonUp="Navigate_Click" ToolTip="Go to this session"/>
                        </StackPanel>
                        <!-- RIGHT: the status pill, ALONE — and since the left accent bar is retired, THE one
                             status surface. Sized to match the monogram chip (same padding + font) so the two
                             row anchors (project left, status right) read as peers. The action buttons
                             (the toggles, archive, the replies) live in the bottom actions row. -->
                        <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{Binding AccentTint}"
                                Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center">
                          <TextBlock Style="{StaticResource PillText}" FontSize="12.5"
                                     Text="{Binding StatusText}" Foreground="{Binding Accent}"/>
                        </Border>
                      </Grid>

                      <!-- DUPLICATE-NAME marker — its own pill row. A warning for YOU, not the app: every action
                           is session-id keyed, but two same-named cards are how a prompt you type lands in the
                           wrong window. -->
                      <!-- Plain visibility, NOT the reserve rule: reserving here charged EVERY card a permanent
                           ~25px dead band between the identity row and the detail text for a pill that rarely
                           shows. A duplicate-bearing card shifting its content down a row is the cheaper evil. -->
                      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0"
                                  Visibility="{Binding DuplicateVisibility}">
                        <Border Style="{StaticResource Pill}" Background="#1AFFFFFF"
                                ToolTip="Another live session has this exact name — a prompt YOU type may land in the wrong window. Tell them apart by the project chip, or rename one.">
                          <TextBlock Style="{StaticResource PillText}" Text="&#x26A0; DUPLICATE NAME" Foreground="{StaticResource TextHi}"/>
                        </Border>
                      </StackPanel>

                      <!-- detail text (agent output on finish / your command while working). A read-only,
                           borderless TextBox (NOT a TextBlock) so the text is SELECTABLE / copyable. NO fixed
                           height and NO reserve rule: it lives in the grid's * row, so it FILLS whatever the
                           optional rows don't use and scrolls inside when the text is longer. When Collapsed
                           (idle rows) the * row simply stays blank — the bottom rows are pinned either way.
                           A card that does not need you dims it one step (DetailBrush, with TitleBrush).
                           Above it, the YOU block: your last prompt to this session (YouText), two lines at most,
                           the whole of it on hover — your side of the exchange on a faint bubble, the agent's side
                           below, so the detail keeps the agent's words alone. No "you" label: the bubble and its
                           place say whose it is, as in a chat. It eats from the detail's * row. -->
                      <Grid Grid.Row="3" Margin="0,5,0,0">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Visibility="{Binding YouVisibility}" Background="#0DFFFFFF"
                                CornerRadius="6" Padding="8,4" Margin="0,0,0,6" ToolTip="{Binding YouText}">
                          <TextBlock Text="{Binding YouText}" Foreground="{StaticResource TextLo}" FontSize="11.5"
                                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="16"
                                     LineStackingStrategy="BlockLineHeight" MaxHeight="32"/>
                        </Border>
                        <TextBox Grid.Row="1" Text="{Binding Detail, Mode=OneWay}"
                                 Visibility="{Binding DetailVisibility}"
                                 IsReadOnly="True" IsTabStop="False" Cursor="IBeam"
                                 BorderThickness="0" Background="Transparent" Padding="0" Margin="0"
                                 Foreground="{Binding DetailBrush}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                          <!-- A WORKING card's tool line in the mono face, a step smaller than the prose — glanced at,
                               never read (AgentEvent.DetailIsTool); the font and its size are never set locally here,
                               which would outrank the trigger. -->
                          <TextBox.Style>
                            <Style TargetType="TextBox">
                              <Setter Property="FontSize" Value="12.5"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding DetailIsTool}" Value="True">
                                  <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                  <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBox.Style>
                        </TextBox>
                      </Grid>

                      <!-- TODO LIST (#3): a compact "<done>/<total> · <current item>" summary; click to expand
                           the full checklist (glyph + status colour per item). Hidden when the session never
                           used TodoWrite. -->
                      <!-- Plain visibility, NOT the reserve rule: an appearing todo row eats from the * detail
                           row ABOVE it, so the bottom rows never move (no ripple). -->
                      <Expander Grid.Row="4" Margin="0,5,0,0" Foreground="{StaticResource TextMid}" FontSize="11"
                                Visibility="{Binding TodoVisibility}">
                        <Expander.Header>
                          <TextBlock Text="{Binding TodoSummary}" Foreground="{StaticResource TextMid}"
                                     FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </Expander.Header>
                        <!-- Bounded + own scrollbar: the card is a FIXED height, so an unbounded list would push
                             past the border (see EventCard ClipToBounds). Matches the error body's budget. -->
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Todos}" Margin="2,4,0,2">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"
                                           FontSize="11" Width="16" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding Content}" Foreground="{StaticResource TextLo}"
                                           FontSize="11" TextWrapping="Wrap" MaxWidth="280"/>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                      </Expander>

                      <!-- BOTTOM: context fill (shortened) + its label, then the recency time at the far right. -->
                      <Grid Grid.Row="5" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Visibility="{Binding ContextVisibility}"
                                     VerticalAlignment="Center" Height="4"
                                     Minimum="0" Maximum="1000000" Value="{Binding ContextTokens}"
                                     Foreground="{Binding ContextBrush}" Background="#1AFFFFFF" BorderThickness="0">
                          <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                              <Border CornerRadius="2" Background="{TemplateBinding Background}">
                                <Grid ClipToBounds="True">
                                  <Border x:Name="PART_Track"/>
                                  <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                          CornerRadius="2" Background="{TemplateBinding Foreground}"/>
                                </Grid>
                              </Border>
                            </ControlTemplate>
                          </ProgressBar.Template>
                        </ProgressBar>
                        <TextBlock Grid.Column="1" Text="{Binding ContextText}" Visibility="{Binding ContextVisibility}"
                                   Foreground="{StaticResource TextLo}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="{StaticResource TextLo}"
                                   FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"/>
                      </Grid>

                      <!-- PERMISSION ANSWER (#5): allow-ONCE / deny one permission from the panel over CDP — no
                           window hop. Allow = the dialog's allow-ONCE (first) button, Deny = the last; the blanket
                           "allow for all" is auto-allow's job, not here. The whole row collapses off NEEDS-PERMISSION
                           cards so it reserves no space. (Stop/continue live in the actions row below.) -->
                      <!-- Plain visibility, NOT the reserve rule: reserving charged every non-permission card an
                           invisible ~27px band between the token bar and auto-allow — doubly dead on
                           auto-allow-ON cards, which can never show this row at all. -->
                      <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0"
                                  Visibility="{Binding PermissionAnswerVisibility}">
                        <Button Style="{StaticResource GhostButton}"
                                Content="allow once" Padding="9,2" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand"
                                Foreground="{StaticResource TextHi}" Click="Allow_Click"
                                ToolTip="Allow just this request — not a blanket grant (that's auto-allow)"/>
                        <Button Style="{StaticResource GhostButton}"
                                Content="deny" Padding="9,2" Margin="6,0,0,0" FontSize="10.5" Cursor="Hand"
                                Click="Deny_Click" ToolTip="Deny this request"/>
                      </StackPanel>

                      <!-- SEND ROW: the model toggle on the LEFT, the send-a-prompt menu on the RIGHT (auto-allow is
                           the actions row's `auto` toggle below). -->
                      <Grid Grid.Row="7" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- MODEL toggle: flips the session between default and heavy over CDP (prompts.json's
                             model_on / model_off). It is ALSO the heavy-model indicator (the toggle-button idiom):
                             solid red fill + white text while heavy — red is the cost hue — dim text when default;
                             the one heavy-model surface. Text, never ⚡: ⚡ is Claude Code's own fast-mode mark, and
                             the label is the heavy model's name (heavy_match), so it says what it switches to. -->
                        <Button Grid.Column="0" Style="{StaticResource ModelButton}" Visibility="{Binding ModelToggleVisibility}"
                                Content="{Binding ModelToggleLabel}" Padding="8,2" HorizontalAlignment="Left"
                                FontSize="10.5" Cursor="Hand"
                                Background="{Binding ModelToggleBg}" Foreground="{Binding ModelGlyphBrush}"
                                Click="ModelToggle_Click" VerticalAlignment="Center"
                                ToolTip="{Binding ModelToggleTip}"/>

                        <!-- SEND A PROMPT: right-aligned. Opens the confirm-before-send picker (SendMenu_Click →
                             PickerWindow) over the one PromptPresets.All source; the chosen prompt is injected into
                             this session's composer over CDP (no focus-steal — see CdpInjector). Hidden on rows we
                             can't address (no session). -->
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Visibility="{Binding SendVisibility}"
                                Content="send a prompt &#x25BE;" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="7,2" FontSize="10.5" Cursor="Hand"
                                Click="SendMenu_Click" ToolTip="Pick a canned prompt to send to this session"/>
                      </Grid>

                      <!-- ACTIONS ROW — its own line BELOW send. LEFT: the `auto` toggle, then archive. RIGHT: the
                           quick replies `rec` · `go` (FINISHED / WAITING FOR YOU) or the STALLED? pill (WORKING, or
                           WAITING past half an hour) — never both, so they share the cell, and the replies sit as far
                           from the toggle as the card allows. -->
                      <Grid Grid.Row="8" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- AUTO-ALLOW: per-session "stop asking me" switch (real session cards only). When ON,
                             Mastermind answers this session's PermissionRequest allow off autoallow.json — over its
                             HTTP entry while it runs, through the exe's own hook entry while it is closed. A text
                             toggle (TextToggle): ON a filled neutral chip, off dim text; the sentence is the tooltip.
                             Click is Handled in AutoAllow_Click so toggling never also navigates the card. -->
                        <CheckBox Style="{StaticResource TextToggle}" Content="auto" FontSize="10.5" Padding="8,2"
                                  Margin="0,0,4,0" VerticalAlignment="Center"
                                  Visibility="{Binding AutoAllowVisibility}" IsChecked="{Binding AutoAllow, Mode=TwoWay}"
                                  Click="AutoAllow_Click">
                          <CheckBox.ToolTip>
                            <TextBlock>
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Text" Value="auto-allow this session"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding AutoAllow}" Value="True">
                                      <Setter Property="Text" Value="auto-allow ON — runs without asking"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </CheckBox.ToolTip>
                        </CheckBox>
                        <!-- ARCHIVE: the extension's own archive, driven from this card, then the idle process
                             stopped — idle cards only (ArchiveVisibility). Two clicks: the first arms. -->
                        <Button Style="{StaticResource GhostButton}" Visibility="{Binding ArchiveVisibility}"
                                Content="archive" Padding="8,2" FontSize="10.5" Cursor="Hand"
                                Foreground="{StaticResource TextLo}" Click="Archive_Click" VerticalAlignment="Center"
                                ToolTip="Archive this session and stop its idle process — click twice (the first click arms it)"/>
                        </StackPanel>
                        <!-- QUICK REPLIES: `rec` sends prompts.json's `rec` ("as you recommend"), `go` its `go` — only
                             on a card whose agent handed you the turn. Two clicks: the first arms (bright "go?"), the
                             second sends (ArmOrFire). Refuse over a hand-typed draft. Neutral at rest — a hue here
                             would claim a status. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding ReplyVisibility}">
                          <Button Style="{StaticResource GhostButton}"
                                  Content="rec" Padding="12,2" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"
                                  Cursor="Hand" Click="Rec_Click"
                                  VerticalAlignment="Center"
                                  ToolTip="Send &quot;as you recommend&quot; — click twice (the first click arms it)"/>
                          <Button Style="{StaticResource GhostButton}"
                                  Content="go" Padding="12,2" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                  Click="Go_Click" VerticalAlignment="Center"
                                  ToolTip="Send &quot;go&quot; — click twice (the first click arms it)"/>
                        </StackPanel>
                        <!-- STALL marker (#1): a WORKING card with no tool starting or finishing for three minutes, or
                             a WAITING card past half an hour; a prompt to go and look, never a verdict. Deliberately
                             NOT in the "who needs you" count. Plain StallVisibility (no reserve rule): the HOST row is
                             always present, so a hidden pill costs no height either way. -->
                        <Border Grid.Column="1" Style="{StaticResource Pill}" Background="#206E7E8F"
                                VerticalAlignment="Center" Visibility="{Binding StallVisibility}"
                                ToolTip="{Binding StallTip}">
                          <TextBlock Style="{StaticResource PillText}" Text="STALLED?" Foreground="{StaticResource TextHi}"/>
                        </Border>
                      </Grid>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.Resources>
          </ItemsControl>
        </Grid>
      </ScrollViewer>

      <!-- ========================= BIG COUNT ============================ -->
      <!-- The log strip's place while it is hidden, at its height so the cards never jump: who needs you, big enough
           to read from across the room, its label under it in the band the numeral's line box leaves below the
           digit's baseline. Fades out at zero, pops on a rise; its colour and the pop are UpdateCount's. -->
      <Border x:Name="BigCount" Grid.Row="2" Height="138" Visibility="Collapsed" IsHitTestVisible="False">
        <Grid x:Name="BigCountBody" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,0" Opacity="0">
          <TextBlock x:Name="BigCountText" Text="0" FontFamily="{StaticResource Display}" FontSize="128"
                     FontWeight="SemiBold" Foreground="{StaticResource Blue}"
                     LineStackingStrategy="BlockLineHeight" LineHeight="134" RenderTransformOrigin="0,1">
            <TextBlock.RenderTransform>
              <ScaleTransform x:Name="BigCountScale"/>
            </TextBlock.RenderTransform>
          </TextBlock>
          <TextBlock Text="NEED YOU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextLo}"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
        </Grid>
      </Border>

      <!-- ====================== ACTIVITY LOG ========================== -->
      <!-- Collapsible bottom strip: incoming hook events + what Mastermind did with each (shown / hidden /
           working / ended), newest at the bottom. Toggled from the footer; visibility persisted. -->
      <Border x:Name="LogPanel" Grid.Row="2" Height="138" BorderThickness="0,1,0,0" BorderBrush="#1AFFFFFF"
              Background="#14000000">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="15,7,10,3">
            <TextBlock Text="ACTIVITY LOG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextLo}"
                       VerticalAlignment="Center"/>
            <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Content="Clear"
                    Padding="7,1" Click="ClearLog_Click"/>
          </Grid>
          <ScrollViewer x:Name="LogScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        Padding="15,0,10,7" CanContentScroll="False">
            <ItemsControl x:Name="LogList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0.5,0,0.5">
                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource Mono}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,0,9,0"/>
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Tint}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- ============================ FOOTER ============================ -->
      <Border x:Name="Footer" Grid.Row="3" Padding="16,9,14,12">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="{StaticResource TextMid}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusLine" Text="listening on 127.0.0.1:7778"
                       Foreground="{StaticResource TextLo}" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LogButton" Style="{StaticResource GhostButton}" Content="Hide log" Click="ToggleLog_Click"
                    Margin="0,0,6,0" ToolTip="Show/hide the activity log"/>
            <Button Style="{StaticResource GhostButton}" Content="Pin on top" x:Name="PinButton" Click="Pin_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>

  <!-- RESIZE GRIPS: invisible edge and corner thumbs over the surface, normal mode only (UpdateChrome collapses them
       in fullscreen, whose fill is the work area). ResizeMode stays NoResize: a resizable frameless window takes
       Windows' snap on a header drag, and the panel parks against a screen edge. The grid has no background, so
       only the thumbs take the mouse. -->
  <Grid x:Name="ResizeGrips">
    <Grid.Resources>
      <Style TargetType="Thumb">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Thumb Tag="Left" Width="6" HorizontalAlignment="Left" Margin="0,12" Cursor="SizeWE" DragDelta="Grip_DragDelta"/>
    <Thumb Tag="Right" Width="6" HorizontalAlignment="Right" Margin="0,12" Cursor="SizeWE" DragDelta="Grip_DragDelta"/>
    <Thumb Tag="Top" Height="6" VerticalAlignment="Top" Margin="12,0" Cursor="SizeNS" DragDelta="Grip_DragDelta"/>
    <Thumb Tag="Bottom" Height="6" VerticalAlignment="Bottom" Margin="12,0" Cursor="SizeNS" DragDelta="Grip_DragDelta"/>
    <Thumb Tag="TopLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="Grip_DragDelta"/>
    <Thumb Tag="TopRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="Grip_DragDelta"/>
    <Thumb Tag="BottomLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="Grip_DragDelta"/>
    <Thumb Tag="BottomRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="Grip_DragDelta"/>
  </Grid>
  </Grid>
</Window>
