<Application x:Class="Mastermind.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mastermind">
  <Application.Resources>
    <ResourceDictionary>

      <!-- The card design height — every card shares it outside fullscreen. MainWindow overrides this key in its
           own resources while fullscreen when two rows at this height don't fit (UpdateCardHeight): the cards
           shrink so two always fit per column, and only the * detail row gives up the height. The sys namespace is
           declared ON the element: Mastermind.UiProbe parses this dictionary cut out of the file, with only the
           two standard namespaces re-declared. -->
      <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="CardHeight">372</sys:Double>
      <!-- The card width, overridden the same way while fullscreen so whole columns fill the width (UpdateCardHeight). -->
      <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="CardWidth">344</sys:Double>

      <!-- ============================ PALETTE ============================ -->
      <!-- Every hue on the panel names a status: green finished, blue your turn or ready, amber needs permission,
           red cost (the heavy model, a near-full context), grey busy. The accent is therefore a bright NEUTRAL —
           the project chip, the header dot, a dialog's action — never a hue. TextLo is the dimmest grey that still
           clears 4.5:1 on Surface. -->
      <Color x:Key="AccentColor">#C8C8D0</Color>
      <Color x:Key="AccentColorHi">#E0E0E6</Color>

      <SolidColorBrush x:Key="TextHi"   Color="#F4F4F6"/>
      <SolidColorBrush x:Key="TextMid"  Color="#A8A8B4"/>
      <SolidColorBrush x:Key="TextLo"   Color="#868691"/>
      <SolidColorBrush x:Key="Mono"     Color="#9A9AA6"/>

      <SolidColorBrush x:Key="Accent"   Color="#C8C8D0"/>
      <SolidColorBrush x:Key="Amber"    Color="#E0A458"/>
      <SolidColorBrush x:Key="Green"    Color="#5FB87A"/>
      <SolidColorBrush x:Key="Blue"     Color="#6EA8FE"/>
      <SolidColorBrush x:Key="Red"      Color="#E5484D"/>

      <SolidColorBrush x:Key="Surface"        Color="#1E1F27"/>
      <SolidColorBrush x:Key="SurfaceHover"   Color="#2A2B36"/>
      <SolidColorBrush x:Key="HairlineBrush"  Color="#22FFFFFF"/>

      <FontFamily x:Key="Sans">Segoe UI Variable Text, Segoe UI</FontFamily>
      <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
      <FontFamily x:Key="MonoFont">Cascadia Code, Cascadia Mono, Consolas</FontFamily>

      <!-- ====================== WINDOW CONTROL BUTTONS ==================== -->
      <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="7">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                  <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ======================= SMALL ICON BUTTON ======================= -->
      <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bg" Background="{TemplateBinding Background}"
                      CornerRadius="8" Width="28" Height="28">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                  <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ====================== TEXT (pill) BUTTON ======================= -->
      <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bg" Background="{TemplateBinding Background}"
                      CornerRadius="8" Padding="10,5" BorderThickness="1" BorderBrush="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bg" Property="Background" Value="#16FFFFFF"/>
                  <Setter TargetName="bg" Property="BorderBrush" Value="#22FFFFFF"/>
                  <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ====================== MODEL TOGGLE BUTTON ====================== -->
      <!-- The model toggle is a STATEFUL text toggle (filled = heavy): its Background is data-bound (solid red
           while on the heavy model, transparent otherwise), so it can't share GhostButton — that template's
           hover trigger REPLACES the background and would wipe the red the instant you mouse over it. Hover
           here dims via Opacity instead, which composes with any bound fill. -->
      <Style x:Key="ModelButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bg" Background="{TemplateBinding Background}"
                      CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bg" Property="Opacity" Value="0.75"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ====================== TEXT TOGGLE (CheckBox) =================== -->
      <!-- A two-state text button — the toggle-button convention (Windows' ToggleButton, VS Code's search toggles):
           ON is a filled neutral chip with bright text, off is dim text alone. No hue: the state it carries is no
           card status. Same geometry as the model toggle beside it. -->
      <Style x:Key="TextToggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextLo}"/>
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Border x:Name="bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                      CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bg" Property="Background" Value="#16FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="bg" Property="Background" Value="#2EFFFFFF"/>
                  <Setter TargetName="bg" Property="BorderBrush" Value="#4DFFFFFF"/>
                  <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ========================= EVENT CARD ============================ -->
      <!-- The card is a PASSIVE surface (not a button) — its interactive bits own their own clicks: the
           title navigates to the session, the auto-allow checkbox toggles, the detail scrolls. Whole-card
           click was retired so reaching into those controls can't accidentally teleport you to the session. -->
      <Style x:Key="EventCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="Width" Value="{DynamicResource CardWidth}"/>
        <Setter Property="Height" Value="{DynamicResource CardHeight}"/>   <!-- every card the same height (incoming / session / placeholder); overflow scrolls inside.
             The design height (CardHeight above) is sized to the card's always-present rows at the uniform 5px row
             rhythm — re-derive it if a row is added or removed; it is the ONE knob, never tune a card individually. -->
        <!-- Load-bearing with the fixed Height: WPF does NOT clip by default, so content taller than the card
             (an expanded todo) would render OUTSIDE the border and overlap the neighbouring card. The
             expander bodies are each MaxHeight-bounded with their own scrollbar; this is the backstop. -->
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Margin" Value="0,0,8,6"/>
      </Style>

      <!-- ===================== PILL GRAMMAR ============================= -->
      <!-- ONE shape/size/type for every status / state / alert pill (session status, prompt state, DUPLICATE,
           STALLED, ERRORS). bg + fg are set per-instance (semantic tone); only the geometry is shared here so
           the pills can't drift apart the way five inline copies did. -->
      <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
      </Style>

      <!-- ===================== SLIM SCROLLBAR ============================ -->
      <Style x:Key="SlimThumb" TargetType="Thumb">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Thumb">
              <!-- Mid grey at ~60% — a fill indicator, never a hue. Margin 0 + the 2px-wide root grid below =
                   exactly 2px, no inset padding. -->
              <Border CornerRadius="1" Background="#99A8A8B4"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- The HORIZONTAL bar is a real grab target, not a hairline. The 2px slim treatment works for the
           vertical bars (a passive fill indicator inside cards and the normal-mode list) but is unusable as a
           drag handle, and fullscreen's column-major list can ONLY be dragged sideways. MinWidth keeps the
           thumb catchable when many columns compress it. Neutral greys on the template's TrackBg pill, never
           the accent: a coloured thumb with no track reads as a progress meter over the big count below it. -->
      <Style x:Key="GrabThumb" TargetType="Thumb">
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Thumb">
              <Border x:Name="Bar" CornerRadius="6" Background="#FF70707B" Margin="1"/>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bar" Property="Background" Value="#FFA8A8B4"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                  <Setter TargetName="Bar" Property="Background" Value="#FFC8C8D2"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Thickness is pinned on the template ROOT via ControlTemplate.Triggers (Width for vertical, Height for
           horizontal) — NOT a Style.Trigger. A Style trigger's Width is out-voted by the desired size of the
           Track / Thumb / RepeatButton parts, so the bar rendered ~8px no matter the value. Sizing the root
           clamps the whole bar to 2px. The Track must take the ScrollBar's Orientation or a horizontal bar
           renders as a broken vertical track. -->
      <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid x:Name="Root" Background="Transparent">
                <Border x:Name="TrackBg" CornerRadius="7"/>
                <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                  <Track.Thumb>
                    <Thumb x:Name="ThumbPart" Style="{StaticResource SlimThumb}"/>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                  </Track.IncreaseRepeatButton>
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                  </Track.DecreaseRepeatButton>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <!-- The host (TextBox/ScrollViewer) reserves a fixed 17px scrollbar column we can't shrink
                     without re-templating it; the root is right/bottom-aligned so the visible bar sits
                     flush to the edge instead of floating mid-gutter. Thickness is MEASURED, never eyeballed —
                     load this very file into a window and read the rendered size.
                     VERTICAL stays a 2px hairline — it's an indicator, and every one of them sits inside a card
                     where the wheel already scrolls. HORIZONTAL is sized to be DRAGGED (14px, inside the 17px
                     gutter, with the GrabThumb): it is the only way to move the fullscreen column-major list by
                     mouse. Scoping by orientation is what keeps the card boxes hairline-thin — they all set
                     HorizontalScrollBarVisibility="Disabled", so they never render a horizontal bar. -->
                <Trigger Property="Orientation" Value="Vertical">
                  <Setter TargetName="Root" Property="Width" Value="2"/>
                  <Setter TargetName="Root" Property="HorizontalAlignment" Value="Right"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                  <Setter TargetName="Root" Property="Height" Value="14"/>
                  <Setter TargetName="Root" Property="VerticalAlignment" Value="Bottom"/>
                  <Setter TargetName="ThumbPart" Property="Style" Value="{StaticResource GrabThumb}"/>
                  <Setter TargetName="TrackBg" Property="Background" Value="#1AFFFFFF"/>
                  <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
