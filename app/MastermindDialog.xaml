<Window x:Class="Mastermind.MastermindDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="460" SizeToContent="Height" MaxHeight="640"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource Sans}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

  <!-- Mastermind's own dialog: a title, the text and one to three buttons in the panel's colours — every
       confirmation and notice, and every refused or failed click, which stays on screen until read. The borderless
       dark shell is PickerWindow's, opaque for the same reason. Keys, not IsDefault / IsCancel: a cancel button's Esc
       sets DialogResult on a window its own Click may already have closed. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1"
                        CornerRadius="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border x:Name="Frame" CornerRadius="8" Background="#FF1A1B22" BorderThickness="1" BorderBrush="#33FFFFFF" SnapsToDevicePixels="True">
    <Grid Margin="18,14,18,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="TitleText" Grid.Row="0" FontFamily="{StaticResource Display}" FontSize="15"
                 FontWeight="SemiBold" Foreground="{StaticResource TextHi}" TextTrimming="CharacterEllipsis"/>
      <TextBox x:Name="BodyText" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True" IsTabStop="False"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               Background="Transparent" Foreground="{StaticResource TextMid}" BorderThickness="0"
               Padding="0" FontSize="12.5"/>
      <StackPanel x:Name="Buttons" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"/>
    </Grid>
  </Border>
</Window>
